    "tailwind-merge": "^2.6.1",
    "tailwindcss": "^3.4.19",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.88.0",
    "@storybook/addon-ondevice-actions": "^10.7.0",
    "@storybook/addon-ondevice-backgrounds": "^10.7.0",
    "@storybook/addon-ondevice-controls": "^10.7.0",
    "@storybook/react-native": "^10.7.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "~19.3.0",
    "babel-plugin-inline-import": "^3.0.0",
    "babel-preset-expo": "~58.0.20",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.31.11",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.12",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "react-dom": "19.3.0",
    "storybook": "^10.6.3",
    "test-renderer": "~1.3.0",
    "typescript": "~7.0.2"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "storybook": "EXPO_PUBLIC_STORYBOOK_ENABLED=true STORYBOOK_DISABLE_TELEMETRY=1 expo start",
    "storybook:generate": "STORYBOOK_DISABLE_TELEMETRY=1 sb-rn-get-stories --config-path .rnstorybook",
    "apk": "node scripts/build-apk.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "test": "jest",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test --ci",
    "db:generate": "drizzle-kit generate && node scripts/db-lock.mjs && pnpm db:fixture",
    "db:fixture": "WRITE_DB_FIXTURES=1 jest src/db/__tests__/upgrade",
    "version:bump": "node scripts/bump-version.mjs",
    "format:check": "oxfmt --check",
    "licences": "node scripts/licences.mjs"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "resolver": "react-native-reanimated/jest/resolver",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^lucide-react-native$": "<rootDir>/node_modules/lucide-react-native/dist/cjs/lucide-react-native.js"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.expo/",
      "<rootDir>/.claude/",
      "<rootDir>/landing/"
    ],
    "testTimeout": 20000,
    "modulePathIgnorePatterns": [
      "<rootDir>/.claude/",
      "<rootDir>/landing/"
    ],
    "setupFiles": [
      "./jest.setup.js"
    ],
    "globalSetup": "./jest.global-setup.js",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|lucide-react-native|@rn-primitives/.*|nativewind|react-native-css-interop|standard-navigation))"
    ]
  }
}
